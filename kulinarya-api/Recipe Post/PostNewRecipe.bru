meta {
  name: PostNewRecipe
  type: http
  seq: 2
}

post {
  url: http://localhost:4000/api/recipes
  body: json
  auth: none
}

body:json {
  {
    "title": "Sisig",
    "foodCategory": "dishes",
    "originProvince": "Isabela",
    "description": "A classic Filipino dish made with sampalok.",
    "ingredients": [
      {
        "quantity": 1,
        "unit": "kg",
        "name": "Pork Ribs"
      },
      {
        "quantity": 1,
        "unit": "cup",
        "name": "Sampalok"
      },
      {
        "quantity": 5,
        "unit": "pcs",
        "name": "Tomato"
      }
    ],
    "procedure": [
      {
        "stepNumber": 1,
        "content": "Boil pork ribs in water until tender."
      },
      {
        "stepNumber": 2,
        "content": "Add sampalok, tomatoes, and season with salt and fish sauce."
      }
    ]
  }
}

docs {
  Authenticate with the kulinarya_auth_token cookie from a login response.
  This saved JSON body is an old example.
  Use multipart form data. Send ingredients and procedure as JSON strings.
  Read API_DOCUMENTATION.md for the current request fields.
  
}
